import java.io.*;
import java.math.*;
import java.security.*;
import java.text.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.function.*;
import java.util.regex.*;
import java.util.stream.*;
import static java.util.stream.Collectors.joining;
import static java.util.stream.Collectors.toList;

class Result {

    /*
     * Complete the 'circularPalindromes' function below.
     *
     * The function is expected to return an INTEGER_ARRAY.
     * The function accepts STRING s as parameter.
     */

   public static List<Integer> circularPalindromes(String s) {
    int n = s.length();

    /*
     * We need 2*n - 1 characters:
     *
     * s + s[0 .. n-2]
     *
     * This is enough to represent every circular substring
     * of length <= n.
     */
    char[] str = new char[2 * n - 1];

    for (int i = 0; i < 2 * n - 1; i++) {
        str[i] = s.charAt(i % n);
    }

    /*
     * Manacher with a separator between characters.
     *
     * Example:
     * "abba"
     *
     * becomes:
     * # a # b # b # a #
     */
    int m = 2 * str.length + 1;
    char[] t = new char[m];

    for (int i = 0; i < m; i++) {
        if ((i & 1) == 0) {
            t[i] = '#';
        } else {
            t[i] = str[i / 2];
        }
    }

    int[] radius = new int[m];

    int center = 0;
    int right = 0;

    for (int i = 0; i < m; i++) {
        int mirror = 2 * center - i;

        if (i < right) {
            radius[i] = Math.min(right - i, radius[mirror]);
        }

        while (i + radius[i] + 1 < m &&
               i - radius[i] - 1 >= 0 &&
               t[i + radius[i] + 1] == t[i - radius[i] - 1]) {
            radius[i]++;
        }

        if (i + radius[i] > right) {
            center = i;
            right = i + radius[i];
        }
    }

    /*
     * best[k] = longest palindrome contained in rotation k.
     *
     * We use a segment tree supporting:
     *
     *     range chmax(value)
     *
     * followed by point queries.
     */
    int size = 1;

    while (size < n) {
        size <<= 1;
    }

    int[] tree = new int[2 * size];

    /*
     * For each palindrome, determine the range of rotations
     * in which that palindrome can occur.
     */
    for (int c = 0; c < m; c++) {

        int len = radius[c];

        if (len == 0) {
            continue;
        }

        /*
         * The radius in the transformed string equals the
         * palindrome length in the original string.
         */
        len = Math.min(len, n);

        /*
         * Convert transformed coordinates to character
         * coordinates.
         */
        int leftChar = (c - len + 1) / 2;
        int rightChar = (c + len - 1) / 2;

        /*
         * A palindrome [leftChar, rightChar] can occur in a
         * rotation beginning at k if:
         *
         *     rightChar - n + 1 <= k <= leftChar
         *
         * modulo n.
         */
        int from = rightChar - n + 1;
        int to = leftChar;

        /*
         * Normalize the interval into [0, n-1].
         */
        from %= n;
        to %= n;

        if (from < 0) {
            from += n;
        }

        if (to < 0) {
            to += n;
        }

        if (from <= to) {
            rangeUpdate(tree, size, from, to, len);
        } else {
            rangeUpdate(tree, size, from, n - 1, len);
            rangeUpdate(tree, size, 0, to, len);
        }
    }

    /*
     * The largest palindrome around a center is not enough
     * by itself. Shorter palindromes can fit into rotations
     * where the largest one does not.
     *
     * Propagate palindrome lengths by 2.
     */
    int[] best = new int[n];

    for (int i = 0; i < n; i++) {
        best[i] = query(tree, size, i);
        if (best[i] == 0) {
            best[i] = 1;
        }
    }

    /*
     * Circular propagation.
     *
     * If a palindrome of length L exists starting at i,
     * neighboring rotations can have length L-2.
     *
     * Repeat around the circle until no improvement is possible.
     *
     * Since values can only decrease by 2 and are <= n,
     * two passes are sufficient.
     */
    boolean changed = true;

    while (changed) {
        changed = false;

        for (int i = 0; i < n; i++) {
            int next = (i + 1) % n;
            int candidate = best[i] - 2;

            if (candidate > best[next]) {
                best[next] = candidate;
                changed = true;
            }
        }

        for (int i = 0; i < n; i++) {
            int prev = (i - 1 + n) % n;
            int candidate = best[i] - 2;

            if (candidate > best[prev]) {
                best[prev] = candidate;
                changed = true;
            }
        }
    }

    List<Integer> result = new ArrayList<>(n);

    for (int i = 0; i < n; i++) {
        result.add(Math.min(best[i], n));
    }

    return result;
}

private static void rangeUpdate(
        int[] tree,
        int size,
        int left,
        int right,
        int value) {

    if (left > right) {
        return;
    }

    left += size;
    right += size;

    while (left <= right) {

        if ((left & 1) == 1) {
            tree[left] = Math.max(tree[left], value);
            left++;
        }

        if ((right & 1) == 0) {
            tree[right] = Math.max(tree[right], value);
            right--;
        }

        left >>= 1;
        right >>= 1;
    }
}

private static int query(int[] tree, int size, int index) {
    int pos = index + size;
    int result = 0;

    while (pos > 0) {
        result = Math.max(result, tree[pos]);
        pos >>= 1;
    }

    return result;
}


}

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));
        BufferedWriter bufferedWriter = new BufferedWriter(new FileWriter(System.getenv("OUTPUT_PATH")));

        int n = Integer.parseInt(bufferedReader.readLine().trim());

        String s = bufferedReader.readLine();

        List<Integer> result = Result.circularPalindromes(s);

        bufferedWriter.write(
            result.stream()
                .map(Object::toString)
                .collect(joining("\n"))
            + "\n"
        );

        bufferedReader.close();
        bufferedWriter.close();
    }
}
