/*
 * Complete the 'matrixRotation' function below.
 *
 * The function accepts following parameters:
 *  1. 2D_INTEGER_ARRAY matrix
 *  2. INTEGER r
 */

void matrixRotation(vector<vector<int>> matrix, int r) {
    int m = matrix.size();
    int n = matrix[0].size();
    int layers = min(m, n) / 2;

    for (int layer = 0; layer < layers; layer++) {
        vector<int> ring;
        
        int top = layer;
        int bottom = m - 1 - layer;
        int left = layer;
        int right = n - 1 - layer;

        // 1. Traverse top row (left to right)
        for (int j = left; j <= right; j++) ring.push_back(matrix[top][j]);
        // 2. Traverse right column (top+1 to bottom)
        for (int i = top + 1; i <= bottom; i++) ring.push_back(matrix[i][right]);
        // 3. Traverse bottom row (right-1 down to left)
        for (int j = right - 1; j >= left; j--) ring.push_back(matrix[bottom][j]);
        // 4. Traverse left column (bottom-1 down to top+1)
        for (int i = bottom - 1; i > top; i--) ring.push_back(matrix[i][left]);

        int len = ring.size();
        int rot = r % len;
        
        // Anti-clockwise shift around boundary
        rotate(ring.begin(), ring.begin() + rot, ring.end());

        // Write rotated values back in the exact same traversal order
        int idx = 0;
        for (int j = left; j <= right; j++) matrix[top][j] = ring[idx++];
        for (int i = top + 1; i <= bottom; i++) matrix[i][right] = ring[idx++];
        for (int j = right - 1; j >= left; j--) matrix[bottom][j] = ring[idx++];
        for (int i = bottom - 1; i > top; i--) matrix[i][left] = ring[idx++];
    }

    // Print final rotated matrix
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            cout << matrix[i][j] << (j == n - 1 ? "" : " ");
        }
        cout << "\n";
    }
}

