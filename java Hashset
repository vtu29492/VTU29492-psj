import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        Set<String> set = new HashSet<>();

        for (int i = 0; i < t; i++) {
            String left = sc.next();
            String right = sc.next();

            set.add(left + " " + right);

            System.out.println(set.size());
        }

        sc.close();
    }
}
