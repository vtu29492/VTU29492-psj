class Solution {

    public String dayOfTheWeek(int day, int month, int year) {

        String[] week = {
            "Sunday",
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday"
        };

        int totalDays = 0;

        // Add days from previous years
        for (int y = 1971; y < year; y++) {
            totalDays += isLeapYear(y) ? 366 : 365;
        }

        // Days in each month
        int[] daysInMonth = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        // Add days from previous months
        for (int m = 1; m < month; m++) {
            totalDays += daysInMonth[m - 1];
        }

        // Add leap day if applicable
        if (month > 2 && isLeapYear(year)) {
            totalDays++;
        }

        // Add previous days in current month
        totalDays += day - 1;

        // Jan 1, 1971 = Friday
        // Friday has index 5
        int dayIndex = (5 + totalDays) % 7;

        return week[dayIndex];
    }

    private boolean isLeapYear(int year) {
        return year % 400 == 0 ||
               (year % 4 == 0 && year % 100 != 0);
    }
}
